# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (default: SQLite). To switch to Postgres:
#   1) change provider in server/prisma/schema.prisma to "postgresql"
#   2) set DATABASE_URL to a postgres URL (postgresql://user:pass@host:5432/db)
DATABASE_URL=file:./dev.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-please
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_ROOT=../storage

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000
