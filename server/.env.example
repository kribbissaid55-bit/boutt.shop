# Bot Said 22 — server environment
# Copy to `server/.env` and fill values. Never commit `.env`.

# --- required ---

# SQLite DSN. On the default deploy this is a relative path to prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"

# HMAC secret for the admin auth cookie (JWT). Must be >= 16 chars.
# Generate: `openssl rand -hex 32`
JWT_SECRET="change-me-openssl-rand-hex-32"

# --- admin bootstrap (used only by prisma/seed.ts on first setup) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# --- server ---
PORT=4000
NODE_ENV="production"

# --- storage ---
# Path relative to CWD (server/). Sessions + media are written here.
STORAGE_ROOT="../storage"

# Set to "s3" and provide credentials if you deploy an S3-compatible backend
# (not required for local single-VPS deploys).
STORAGE_DRIVER="local"

# --- optional ---

# Extra encryption for stored AI provider keys. Any long random string.
# When unset, keys are stored plaintext in the DB (still hidden from UI).
# AI_KEY_SECRET="change-me-openssl-rand-hex-32"

# Baileys logger level. "silent"/"error"/"warn"/"info"/"debug".
# Default: pino sensible default. Turn up when diagnosing a WA session.
# BAILEYS_LOG_LEVEL="info"

# Opt-in error tracking. When set + @sentry/node is installed, unhandled
# rejections and uncaught exceptions are shipped to Sentry alongside pino.
# Zero cost when unset.
# SENTRY_DSN="https://...@sentry.io/..."
