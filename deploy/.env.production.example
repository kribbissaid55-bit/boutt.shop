# =============================================================================
# Bot Said 22 — production .env template
#
# Copy this file to `.env` at the project root (same directory as
# ecosystem.config.cjs and package.json), then fill the values marked REQUIRED.
# The install-vps.sh script does this for you automatically.
#
# NEVER commit this file to git after filling it. Rotate secrets before going
# live; the placeholders below are NOT safe defaults.
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=4000

# --- Database ---
# Default: SQLite at server/prisma/dev.db — fine for the operator's expected
# volume. To move to Postgres later, change `provider` in
# server/prisma/schema.prisma AND swap DATABASE_URL below to a postgres URL.
DATABASE_URL=file:./dev.db

# --- Auth (REQUIRED) ---
# JWT_SECRET signs session cookies. Generate a fresh one with:
#   openssl rand -hex 32
# Rotating this value invalidates every existing session — everyone re-logs in.
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32

# Admin bootstrap. The seed script upserts this account on first boot. AFTER
# the first successful login, change the password from Settings → «الحساب
# والفريق» so it's no longer tied to the .env value.
ADMIN_USERNAME=owner@yourdomain.com
ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD

# --- AI vault (recommended in production) ---
# AI_KEY_SECRET encrypts stored AI provider API keys at rest with AES-256-GCM.
# If unset, a deterministic per-install fallback is used (still safer than
# plaintext, not KMS-grade). Generate with:
#   openssl rand -hex 32
# DO NOT change this after storing keys — existing ciphertexts become unreadable.
AI_KEY_SECRET=

# --- CORS ---
# Comma-separated origins allowed to call /api/* with cookies.
# Empty = same-origin only (the common case, when nginx serves both frontend
# and API from one domain). If your frontend lives on a DIFFERENT origin
# (e.g. app.shop.ma calling api.shop.ma), list ALL those origins here.
# Example: ALLOWED_ORIGINS=https://app.shop.ma,https://admin.shop.ma
ALLOWED_ORIGINS=

# Cookie domain for cross-origin sub-domain deploys. Leave unset for
# same-origin. Example: COOKIE_DOMAIN=.shop.ma
COOKIE_DOMAIN=

# --- Storage ---
STORAGE_DRIVER=local
# Absolute path recommended in production. Uploads + WhatsApp session files
# live here. Back this up — losing storage/ = re-scan every WhatsApp QR.
STORAGE_ROOT=./storage
